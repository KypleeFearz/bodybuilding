# Copy to .env and fill in. Never commit the real .env file.

# --- Auth0 (optional: without these values the app runs in read-only demo mode) ---
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=your-spa-client-id
AUTH0_AUDIENCE=https://bodybuilding-api
AUTH0_CLAIM_NAMESPACE=https://bodybuilding.app/

# --- MongoDB (docker compose sets this automatically) ---
# MONGODB_URI=mongodb://localhost:27017/bodybuilding

# --- Mail notifications (optional) ---
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# MAIL_FROM=no-reply@example.com

# --- Sample data on first start ---
SEED_DEMO_DATA=true
